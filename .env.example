# 이 파일을 복사해서 '.env' 로 만들고 실제 값을 채우세요.  (cp .env.example .env)
# .env 는 절대 공유/커밋 금지 (.gitignore 에 이미 제외됨)

# HuggingFace 토큰 — huggingface.co/settings/tokens
#   Fine-grained 토큰 + "Make calls to Inference Providers" 권한 필수
HF_TOKEN=hf_여기에_토큰_붙여넣기

# ── 확장 [3] DB 도구를 쓸 경우에만 채우세요 ──
# DB_HOST=127.0.0.1
# DB_USER=root
# DB_PASSWORD=
# DB_DATABASE=sales
